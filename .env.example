# Copy to .env and edit. .env is gitignored — never commit real values.

# PostgreSQL (used by the Label Studio container)
POSTGRES_DB=labelstudio
POSTGRES_USER=labelstudio
POSTGRES_PASSWORD=change-me

# Public URL annotators use to reach the instance (used in emails/links)
LABEL_STUDIO_HOST=http://localhost:8080

# Optional: close open signup so only invited users can register
LABEL_STUDIO_DISABLE_SIGNUP_WITHOUT_LINK=true
